# Private listener for SSH MCP Tunnel or an HTTPS reverse proxy.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
# For a public endpoint, configure MCP_BEARER_TOKEN and TLS at your proxy.
# MCP_BEARER_TOKEN=generate-a-long-random-value
# MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
# MCP_ALLOWED_ORIGINS=

SSH_MCP_KNOWN_HOSTS=~/.ssh/known_hosts
SSH_MCP_KEY_ROOT=~/.ssh
SSH_MCP_TRANSFER_ROOT=./transfers
SSH_MCP_PROFILES_FILE=./profiles.json
SSH_MCP_SESSION_TTL=1800
SSH_MCP_MAX_SESSIONS=32
SSH_MCP_MAX_OUTPUT_BYTES=1048576
SSH_MCP_MAX_INLINE_BYTES=1048576
SSH_MCP_MAX_COMMAND_SECONDS=120